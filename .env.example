# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Every variable here is read by app/config.py or rag/config.py.

# ==================================================
# Supabase database, Auth, and Storage
# ==================================================
# Use the bare project URL, not a /rest/v1 endpoint. The service-role key
# is backend-only and must never be copied into web/.env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call FastAPI, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================================================
# LLM (RAG generation layer)
# ==================================================
# mock | groq | anthropic | openai | openrouter | ollama
#
# "mock" is the default and needs no key: it composes answers only from
# retrieved text, so the grounding and refusal paths stay testable offline.
# The test suite depends on it — leave tests on mock.
LLM_PROVIDER=groq

# Groq: get a free key at https://console.groq.com/keys
# OpenRouter: get a free key at https://openrouter.ai/keys — a manual
# failover for when Groq is rate-limited (LLM_PROVIDER=openrouter). Its
# free tier allows 20 requests/minute and 50/day (rising to 1000/day once
# the account has ever purchased $10 of credits, per openrouter.ai/docs) —
# a different shape of limit than Groq's, not necessarily more generous.
# The free model lineup also rotates, so verify openrouter.ai/models
# before relying on the default in app/llm.py.
LLM_API_KEY=
# Optional — defaults to openai/gpt-oss-120b for Groq, or
# google/gemma-4-26b-a4b-it:free for OpenRouter.
LLM_MODEL=

# Ollama (LLM_PROVIDER=ollama): a locally-running model — no key, no rate
# limit, no cost, no network dependency once a model is pulled. Requires
# `ollama serve` running and a model already pulled, e.g.
# `ollama pull qwen2.5:7b-instruct` (the default below), or straight from
# Hugging Face: `ollama pull hf.co/<repo>:<quant>`. Optional OLLAMA_BASE_URL
# (defaults to http://localhost:11434) points at a remote/non-default host.
# Not every model handles response_format=json_object reliably and local
# CPU inference can be slow — verify with
# `python -m scripts.evaluate_rag --provider configured --limit 3` before
# relying on it, and raise LLM_TIMEOUT_SECONDS if generation is CPU-bound.
OLLAMA_BASE_URL=
# Groq's gpt-oss models are reasoning models: hidden reasoning tokens are
# billed against max_tokens before any output is emitted. "medium" pairs
# claims to excerpts more carefully than "low", at the cost of latency
# (~18s vs ~3s observed). Set empty to omit the parameter for models that
# don't accept it (e.g. Anthropic, OpenAI non-reasoning models).
LLM_REASONING_EFFORT=medium
# Generous enough for a "medium"-effort generation plus the retry in
# app/services/generation.py without hanging a patient forever.
LLM_TIMEOUT_SECONDS=45

# Claim-level evidence verification is a mandatory fail-closed stage for
# patient-facing medical answers. Keep enabled outside isolated diagnostics.
EVIDENCE_VERIFIER_ENABLED=true
EVIDENCE_VERIFIER_TIMEOUT_SECONDS=15

# ==================================================
# Uploads
# ==================================================
MAX_UPLOAD_BYTES=52428800

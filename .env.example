# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Every variable here is actually read by app/config.py. Nothing else is.

# ==================================================
# Database
# ==================================================
# Defaults to a local SQLite file if unset, so the app runs with no setup.
# Postgres/Supabase needs no code change — just point this at it.
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# ==================================================
# Auth
# ==================================================
# MUST be set to a random value before deploying anywhere real. The
# fallback in app/config.py is a known public string, so leaving it unset
# means anyone can mint a valid token for any clinic.
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ==================================================
# LLM (RAG generation layer)
# ==================================================
# mock | groq | anthropic | openai
#
# "mock" is the default and needs no key: it composes answers only from
# retrieved text, so the grounding and refusal paths stay testable offline.
# The test suite depends on it — leave tests on mock.
LLM_PROVIDER=groq

# Groq: get a free key at https://console.groq.com/keys
LLM_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile for Groq.
LLM_MODEL=

# ==================================================
# Uploads
# ==================================================
MAX_UPLOAD_BYTES=52428800

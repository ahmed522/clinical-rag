# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# Every variable here is read by app/config.py or src/config.py.

# ==================================================
# Supabase database, Auth, and Storage
# ==================================================
# Use the bare project URL, not a /rest/v1 endpoint. The service-role key
# is backend-only and must never be copied into web/.env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call FastAPI, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==================================================
# LLM (RAG generation layer)
# ==================================================
# mock | groq | anthropic | openai
#
# "mock" is the default and needs no key: it composes answers only from
# retrieved text, so the grounding and refusal paths stay testable offline.
# The test suite depends on it — leave tests on mock.
LLM_PROVIDER=groq

# Groq: get a free key at https://console.groq.com/keys
LLM_API_KEY=
# Optional — defaults to openai/gpt-oss-120b for Groq.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=25

# Claim-level evidence verification is a mandatory fail-closed stage for
# patient-facing medical answers. Keep enabled outside isolated diagnostics.
EVIDENCE_VERIFIER_ENABLED=true
EVIDENCE_VERIFIER_TIMEOUT_SECONDS=15

# ==================================================
# Uploads
# ==================================================
MAX_UPLOAD_BYTES=52428800
